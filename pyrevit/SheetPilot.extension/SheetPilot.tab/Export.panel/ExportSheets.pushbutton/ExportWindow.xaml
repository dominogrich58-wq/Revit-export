<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SheetPilot - export vykresov"
        Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" SnapsToDevicePixels="True"
        Closing="window_closing">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0B6E7A"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F4F7F9"/>
    <SolidColorBrush x:Key="Surface3" Color="#E3EAEF"/>
    <SolidColorBrush x:Key="Line" Color="#C9D4DE"/>
    <SolidColorBrush x:Key="Ink" Color="#14202A"/>
    <SolidColorBrush x:Key="Muted" Color="#5C6B79"/>
    <SolidColorBrush x:Key="Ok" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="Warn" Color="#A8621B"/>
    <SolidColorBrush x:Key="Danger" Color="#B3261E"/>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="26"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Padding" Value="22,7"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3,16,3"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="24"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource Surface}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- farebna horna lista -->
    <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="14,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="SheetPilot" FontWeight="SemiBold"
                   FontSize="14" Foreground="{StaticResource AccentInk}"
                   VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Left" x:Name="model_label" Margin="12,0,0,0"
                   FontFamily="Consolas" FontSize="12" Opacity="0.75"
                   Foreground="{StaticResource AccentInk}" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" x:Name="version_label" Opacity="0.7"
                   FontSize="11" Foreground="{StaticResource AccentInk}"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- === FORMULAR === -->
    <Grid Grid.Row="1" x:Name="form_view">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- profily -->
      <Border Grid.Row="0" Background="{StaticResource Surface2}"
              BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="PROFIL" Style="{StaticResource Eyebrow}" Margin="0,0,8,0"
                     VerticalAlignment="Center"/>
          <ComboBox x:Name="profile_box" Width="200"
                    SelectionChanged="on_profile_changed"/>
          <Button Content="Uložiť" Click="on_profile_save"/>
          <Button Content="Uložiť ako…" Click="on_profile_save_as"/>
          <Button Content="Zmazať" Click="on_profile_delete"/>
          <Button Content="Načítať zo súboru" Click="on_profile_import"/>
          <Button Content="Uložiť do súboru" Click="on_profile_export"/>
        </StackPanel>
      </Border>

      <!-- telo -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="462"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- vykresy -->
        <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                Padding="14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="VÝKRESY" Style="{StaticResource Eyebrow}"/>
                <TextBlock x:Name="sheet_count" Style="{StaticResource Eyebrow}"
                           Margin="8,0,0,6" Foreground="{StaticResource Accent}"/>
              </StackPanel>
              <TextBox x:Name="filter_box" TextChanged="on_filter_changed" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Sheet Set" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="sheetset_box" Width="300"
                          SelectionChanged="on_sheetset_changed"/>
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Všetko" Click="on_select_all"/>
              <Button Content="Nič" Click="on_select_none"/>
              <Button Content="Obrátiť" Click="on_select_invert"/>
              <Button Content="Vybrať filtrované" Click="on_select_visible"/>
            </StackPanel>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Background="{StaticResource Surface2}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Background="{StaticResource Surface3}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="44"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Text="ČÍSLO" Style="{StaticResource Eyebrow}" Margin="0,4"/>
                  <TextBlock Grid.Column="2" Text="NÁZOV" Style="{StaticResource Eyebrow}" Margin="0,4"/>
                  <TextBlock Grid.Column="3" Text="ROZMER" Style="{StaticResource Eyebrow}" Margin="0,4"/>
                  <TextBlock Grid.Column="4" Text="REV" Style="{StaticResource Eyebrow}" Margin="0,4"/>
                </Grid>
                <ListBox x:Name="sheet_list" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="26"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="96"/>
                          <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=TwoWay}"
                                  Margin="0" VerticalAlignment="Center"
                                  Checked="on_sheet_toggled" Unchecked="on_sheet_toggled"/>
                        <TextBlock Grid.Column="1" Text="{Binding Number}" FontFamily="Consolas"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontFamily="Consolas"
                                   FontSize="11" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding Revision}" FontFamily="Consolas"
                                   FontSize="11" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </DockPanel>
        </Border>

        <!-- nastavenia -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">

            <TextBlock Text="FORMÁTY" Style="{StaticResource Eyebrow}"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="pdf_check" Content="PDF" FontWeight="SemiBold"
                        Click="on_format_changed"/>
              <CheckBox x:Name="dwg_check" Content="DWG" FontWeight="SemiBold"
                        Click="on_format_changed"/>
            </StackPanel>

            <Border x:Name="pdf_panel" BorderBrush="{StaticResource Accent}"
                    BorderThickness="2,0,0,0" Padding="10,4,0,4" Margin="0,6,0,0">
              <StackPanel>
                <CheckBox x:Name="combine_check" Content="Spojiť všetky výkresy do jedného PDF"
                          Click="on_setting_changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Kvalita rastra" Foreground="{StaticResource Muted}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="quality_box" Width="130"/>
                  <TextBlock Text="Farby" Foreground="{StaticResource Muted}"
                             VerticalAlignment="Center" Margin="10,0,8,0"/>
                  <ComboBox x:Name="color_box" Width="120"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="dwg_panel" BorderBrush="{StaticResource Accent}"
                    BorderThickness="2,0,0,0" Padding="10,4,0,4" Margin="0,8,0,0">
              <StackPanel>
                <CheckBox x:Name="noxref_check"
                          Content="Jeden DWG na výkres, bez externých referencií"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Export Setup" Foreground="{StaticResource Muted}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="dwgsetup_box" Width="200"/>
                  <TextBlock Text="Verzia" Foreground="{StaticResource Muted}"
                             VerticalAlignment="Center" Margin="10,0,8,0"/>
                  <ComboBox x:Name="dwgversion_box" Width="130"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
              <TextBlock Text="NÁZOV SÚBORU" Style="{StaticResource Eyebrow}"/>
              <Button Content="Upraviť názov…" HorizontalAlignment="Right" Margin="0,-4,0,0"
                      Click="on_edit_name"/>
            </Grid>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Background="{StaticResource Surface2}" Padding="7" MinHeight="34">
              <ItemsControl x:Name="chip_list">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Background="{StaticResource Surface}" CornerRadius="2"
                            Padding="6,2" Margin="0,0,4,4">
                      <TextBlock Text="{Binding Label}" FontSize="12"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,1"
                    Background="{StaticResource Surface2}" Padding="9,6" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="UKÁŽKA" Style="{StaticResource Eyebrow}" Margin="0,0,10,0"/>
                <TextBlock x:Name="preview_label" Style="{StaticResource Mono}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- pata -->
      <Border Grid.Row="2" Background="{StaticResource Surface2}"
              BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="VÝSTUP" Style="{StaticResource Eyebrow}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Prehľadávať…" Margin="6,0,0,0"
                    Click="on_pick_folder"/>
            <TextBox x:Name="folder_box" FontFamily="Consolas" Margin="0"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="subfolder_check" Content="Podpriečinky PDF a DWG"/>
            <CheckBox x:Name="overwrite_check" Content="Prepisovať existujúce súbory"/>
            <CheckBox x:Name="openafter_check" Content="Po dokončení otvoriť priečinok"/>
          </StackPanel>
          <DockPanel>
            <TextBlock x:Name="status_label" DockPanel.Dock="Left"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Button Content="Zavrieť" Click="on_close"/>
              <Button x:Name="export_button" Content="Exportovať" Style="{StaticResource Primary}"
                      Click="on_export"/>
            </StackPanel>
            <TextBlock/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- === PRIEBEH === -->
    <Grid Grid.Row="1" x:Name="progress_view" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" Margin="60">
        <TextBlock Text="PREBIEHA EXPORT" Style="{StaticResource Eyebrow}"/>
        <ProgressBar x:Name="progress_bar" Height="8" Minimum="0" Maximum="100"
                     Foreground="{StaticResource Accent}" Margin="0,4,0,10"/>
        <DockPanel>
          <TextBlock x:Name="progress_count" DockPanel.Dock="Right"
                     Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="progress_text" Style="{StaticResource Mono}" FontSize="13"/>
        </DockPanel>
        <Button Content="Prerušiť" HorizontalAlignment="Right" Margin="0,18,0,0"
                Click="on_cancel_run"/>
      </StackPanel>
    </Grid>

    <!-- === VÝSLEDOK === -->
    <Grid Grid.Row="1" x:Name="result_view" Visibility="Collapsed" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" x:Name="result_head" Style="{StaticResource Eyebrow}"/>

      <Border Grid.Row="1" Background="{StaticResource Surface2}"
              BorderBrush="{StaticResource Line}" BorderThickness="1"
              Padding="12,8" Margin="0,0,0,10">
        <TextBlock x:Name="result_summary" Style="{StaticResource Mono}" FontSize="13"/>
      </Border>

      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <ListBox x:Name="result_list" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="86"/>
                  <ColumnDefinition Width="46"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{Binding StatusBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Format}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontFamily="Consolas"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TextBlock Grid.Row="3" x:Name="result_note" Margin="0,8,0,0" TextWrapping="Wrap"/>

      <DockPanel Grid.Row="4" Margin="0,12,0,0">
        <TextBlock x:Name="result_log" DockPanel.Dock="Left" FontSize="11"
                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Späť na nastavenia" Click="on_back"/>
          <Button Content="Otvoriť priečinok" Style="{StaticResource Primary}"
                  Click="on_open_folder"/>
        </StackPanel>
        <TextBlock/>
      </DockPanel>
    </Grid>

  </Grid>
</Window>
